 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
            /* =========================================================
               Arayüz etkileşimleri
               Veriler HTML içinde durur; JavaScript yalnızca
               data-* değerlerini okur ve görünümü değiştirir.
               ========================================================= */

            const mailList      = document.getElementById('mailList');
            const selectAll     = document.getElementById('selectAll');
            const inboxSearch   = document.getElementById('inboxSearch');
            const inboxToolbar  = document.getElementById('inboxToolbar');
            const selectionInfo = document.getElementById('selectionInfo');
            const mailEmpty     = document.getElementById('mailEmpty');

            let activeFilter = 'all';

            // Yardımcı fonksiyonlar
            function getAllMails() {
                return Array.from(mailList.querySelectorAll('.mail-item'));
            }
            function getVisibleMails() {
                return getAllMails().filter(mail => !mail.hidden);
            }
            function getSelectedMails() {
                return getAllMails().filter(mail => mail.querySelector('.mail-check').checked);
            }

            // Bootstrap tooltip'lerini başlat
            document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));


            /* ---------- 1. Sidebar aç / kapat ---------- */
            document.getElementById('sidebarToggle').addEventListener('click', function () {
                if (window.innerWidth < 992) {
                    document.body.classList.toggle('sidebar-open');      // mobil: üstte açılır
                } else {
                    document.body.classList.toggle('sidebar-collapsed'); // masaüstü: gizlenir
                }
            });

            document.getElementById('sidebarBackdrop').addEventListener('click', function () {
                document.body.classList.remove('sidebar-open');
            });


            /* ---------- 2. Sayaçları güncelle ---------- */
            function updateCounts() {
                const mails = getAllMails();
                const total = mails.length;
                const unread = mails.filter(m => m.dataset.read === 'false').length;
                const starred = mails.filter(m => m.dataset.starred === 'true').length;
                const attachment = mails.filter(m => m.dataset.attachment === 'true').length;

                document.getElementById('totalCount').textContent = total;
                document.getElementById('footerTotal').textContent = total;
                document.getElementById('unreadCount').textContent = unread;
                document.getElementById('sidebarUnreadCount').textContent = unread;
                document.getElementById('sidebarStarredCount').textContent = starred;

                document.querySelector('[data-count="all"]').textContent = total;
                document.querySelector('[data-count="unread"]').textContent = unread;
                document.querySelector('[data-count="starred"]').textContent = starred;
                document.querySelector('[data-count="attachment"]').textContent = attachment;
            }


            /* ---------- 3. Filtreleme ve arama ---------- */
            function applyFilters() {
                const term = inboxSearch.value.trim().toLocaleLowerCase('tr');
                let visibleCount = 0;

                getAllMails().forEach(function (mail) {
                    // Filtre sekmesine göre kontrol
                    let matchesFilter = true;
                    if (activeFilter === 'unread')     matchesFilter = mail.dataset.read === 'false';
                    if (activeFilter === 'starred')    matchesFilter = mail.dataset.starred === 'true';
                    if (activeFilter === 'attachment') matchesFilter = mail.dataset.attachment === 'true';

                    // Gönderen, konu ve önizleme içinde arama
                    const text = (
                        mail.querySelector('.mail-sender').textContent + ' ' +
                        mail.querySelector('.mail-subject').textContent + ' ' +
                        mail.querySelector('.mail-preview').textContent
                    ).toLocaleLowerCase('tr');
                    const matchesSearch = text.includes(term);

                    mail.hidden = !(matchesFilter && matchesSearch);
                    if (!mail.hidden) visibleCount++;
                });

                mailEmpty.hidden = visibleCount > 0;
                updateSelection();
            }

            document.querySelectorAll('.inbox-filter').forEach(function (button) {
                button.addEventListener('click', function () {
                    document.querySelectorAll('.inbox-filter').forEach(b => b.classList.remove('active'));
                    button.classList.add('active');
                    activeFilter = button.dataset.filter;
                    applyFilters();
                });
            });

            inboxSearch.addEventListener('input', applyFilters);


            /* ---------- 4. Seçim ve tümünü seç ---------- */
            function updateSelection() {
                const visible = getVisibleMails();
                const selected = getSelectedMails();

                getAllMails().forEach(function (mail) {
                    mail.classList.toggle('is-selected', mail.querySelector('.mail-check').checked);
                });

                const allVisibleSelected = visible.length > 0 &&
                    visible.every(mail => mail.querySelector('.mail-check').checked);

                selectAll.checked = allVisibleSelected;
                selectAll.indeterminate = selected.length > 0 && !allVisibleSelected;

                inboxToolbar.classList.toggle('has-selection', selected.length > 0);
                selectionInfo.textContent = selected.length > 0 ? selected.length + ' mesaj seçildi' : '';
            }

            selectAll.addEventListener('change', function () {
                getVisibleMails().forEach(function (mail) {
                    mail.querySelector('.mail-check').checked = selectAll.checked;
                });
                updateSelection();
            });

            mailList.addEventListener('change', function (event) {
                if (event.target.classList.contains('mail-check')) updateSelection();
            });


            /* ---------- 5. Yıldız ve mesaj açma ---------- */
            mailList.addEventListener('click', function (event) {
                const mail = event.target.closest('.mail-item');
                if (!mail) return;

                // Yıldıza tıklandı
                if (event.target.closest('.mail-star')) {
                    const isStarred = mail.dataset.starred === 'true';
                    mail.dataset.starred = isStarred ? 'false' : 'true';
                    const icon = mail.querySelector('.mail-star i');
                    icon.className = isStarred ? 'bi bi-star' : 'bi bi-star-fill';
                    updateCounts();
                    applyFilters();
                    return;
                }

                // Mesaja tıklandı: demo olarak okundu yapılır.
                // MVC'de bu bağlantı /Mail/Detail/{id} sayfasına gidecek.
                if (event.target.closest('.mail-body')) {
                    event.preventDefault();
                    mail.dataset.read = 'true';
                    updateCounts();
                    applyFilters();
                }
            });


            /* ---------- 6. Okundu / okunmadı işaretle ---------- */
            function setReadState(isRead) {
                const selected = getSelectedMails();
                if (selected.length === 0) return;

                selected.forEach(function (mail) {
                    mail.dataset.read = isRead ? 'true' : 'false';
                    mail.querySelector('.mail-check').checked = false;
                });
                updateCounts();
                applyFilters();
            }

            document.getElementById('markReadBtn').addEventListener('click', () => setReadState(true));
            document.getElementById('markUnreadBtn').addEventListener('click', () => setReadState(false));


            /* ---------- 7. Silme (onaylı demo) ---------- */
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const appToast = new bootstrap.Toast(document.getElementById('appToast'), { delay: 2500 });

            function showToast(message) {
                document.getElementById('appToastText').textContent = message;
                appToast.show();
            }

            document.getElementById('deleteBtn').addEventListener('click', function () {
                const count = getSelectedMails().length;
                if (count === 0) return;
                document.getElementById('deleteCount').textContent = count;
                deleteModal.show();
            });

            document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
                const selected = getSelectedMails();
                selected.forEach(mail => mail.remove());
                deleteModal.hide();
                updateCounts();
                applyFilters();
                showToast(selected.length + ' mesaj Çöp Kutusu\'na taşındı.');
            });


            /* ---------- 8. Yenile ---------- */
            document.getElementById('refreshBtn').addEventListener('click', function () {
                const button = this;
                button.classList.add('is-spinning');
                setTimeout(() => button.classList.remove('is-spinning'), 600);
                showToast('Gelen kutusu güncel.');
            });
    </script>