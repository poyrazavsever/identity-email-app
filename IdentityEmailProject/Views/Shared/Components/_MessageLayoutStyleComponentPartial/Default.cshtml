<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gelen Kutusu — Postane</title>

    <!-- Yazı tipi: Inter (Türkçe karakter desteği için latin-ext dahil) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 ve Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

<style>
            /* =========================================================
                       1. TEMA DEĞİŞKENLERİ
                       Renkler tek bir yerden yönetilir. Diğer sayfalar da
                       aynı değişkenleri kullanacak.
                       ========================================================= */
            :root {
                /* Yüzeyler */
                --app-bg: #F6F4EF; /* kırık beyaz */
                --surface: #FFFFFF;
                --surface-soft: #FBFAF7;
                --sidebar-bg: #EFEBE3; /* açık bej */
                /* Çizgiler */
                --border: #E3DED3;
                --border-soft: #EEEAE2;
                /* Metin (sıcak gri tonları) */
                --text: #2A2925;
                --text-2: #4F4C45;
                --text-muted: #8A857B;
                /* Adaçayı yeşili */
                --sage: #9DBBA4;
                --sage-strong: #4D7A5B;
                --sage-hover: #436C50;
                --sage-soft: #E1ECE3;
                --sage-tint: #F1F6F2;
                /* Şeftali */
                --peach: #F0C9AE;
                --peach-strong: #B2643A;
                --peach-soft: #FBEADF;
                /* Etiket renkleri */
                --label-work-bg: #E1ECE3;
                --label-work-text: #44704F;
                --label-personal-bg: #FBE6D8;
                --label-personal-text: #A65A32;
                --label-important-bg: #F5DCD6;
                --label-important-text: #9E4638;
                --label-invoice-bg: #F3E8C9;
                --label-invoice-text: #866A22;
                --label-support-bg: #DFE7EA;
                --label-support-text: #4B6672;
                /* Ölçüler */
                --sidebar-width: 264px;
                --navbar-height: 64px;
                --radius: 8px;
                --radius-sm: 6px;
            }

            /* =========================================================
                       2. GENEL
                       ========================================================= */
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
                font-size: 14px;
                color: var(--text);
                background: var(--app-bg);
                -webkit-font-smoothing: antialiased;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .form-check-input {
                border-color: #C9C3B7;
                cursor: pointer;
            }

                .form-check-input:checked,
                .form-check-input:indeterminate {
                    background-color: var(--sage-strong);
                    border-color: var(--sage-strong);
                }

                .form-check-input:focus {
                    border-color: var(--sage);
                    box-shadow: 0 0 0 3px rgba(77, 122, 91, .15);
                }

            .icon-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 36px;
                height: 36px;
                padding: 0;
                border: 0;
                border-radius: var(--radius-sm);
                background: transparent;
                color: var(--text-2);
                font-size: 17px;
                position: relative;
                transition: background-color .15s, color .15s;
            }

                .icon-btn:hover {
                    background: var(--border-soft);
                    color: var(--text);
                }

                .icon-btn:focus-visible {
                    outline: 2px solid var(--sage);
                    outline-offset: 1px;
                }

            /* =========================================================
                       3. SIDEBAR  (_Sidebar.cshtml)
                       ========================================================= */
            .app-sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                width: var(--sidebar-width);
                display: flex;
                flex-direction: column;
                background: var(--sidebar-bg);
                border-right: 1px solid var(--border);
                z-index: 1040;
                transition: transform .2s ease;
            }

            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                height: var(--navbar-height);
                padding: 0 22px;
            }

            .sidebar-brand-name {
                font-size: 17px;
                font-weight: 700;
                letter-spacing: -0.02em;
                line-height: 1.1;
            }

            .sidebar-brand-tagline {
                display: block;
                font-size: 11px;
                font-weight: 500;
                color: var(--text-muted);
                letter-spacing: 0;
            }

            .sidebar-compose {
                padding: 6px 18px 18px;
            }

            .btn-compose {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                width: 100%;
                height: 40px;
                border: 0;
                border-radius: var(--radius);
                background: var(--sage-strong);
                color: #fff;
                font-weight: 600;
                font-size: 14px;
                transition: background-color .15s;
            }

                .btn-compose:hover {
                    background: var(--sage-hover);
                    color: #fff;
                }

            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                padding: 0 12px 16px;
            }

            .sidebar-heading {
                margin: 18px 10px 6px;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: .06em;
                text-transform: uppercase;
                color: var(--text-muted);
            }

                .sidebar-heading:first-child {
                    margin-top: 4px;
                }

            .sidebar-menu {
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                height: 36px;
                padding: 0 10px;
                margin-bottom: 1px;
                border-radius: var(--radius-sm);
                color: var(--text-2);
                font-weight: 500;
                transition: background-color .15s, color .15s;
            }

                .sidebar-link i {
                    font-size: 16px;
                    width: 18px;
                    text-align: center;
                    color: var(--text-muted);
                }

                .sidebar-link:hover {
                    background: rgba(255, 255, 255, .55);
                    color: var(--text);
                }

                .sidebar-link.active {
                    background: var(--sage-soft);
                    color: var(--sage-strong);
                    font-weight: 600;
                }

                    .sidebar-link.active i {
                        color: var(--sage-strong);
                    }

            .sidebar-count {
                margin-left: auto;
                min-width: 22px;
                padding: 1px 7px;
                border-radius: 10px;
                background: rgba(255, 255, 255, .7);
                color: var(--text-muted);
                font-size: 11px;
                font-weight: 600;
                text-align: center;
            }

            .sidebar-link.active .sidebar-count {
                background: var(--sage-strong);
                color: #fff;
            }

            /* Etiket ikon renkleri */
            .sidebar-link .tag-work {
                color: #6E9B79;
            }

            .sidebar-link .tag-personal {
                color: #D69469;
            }

            .sidebar-link .tag-important {
                color: #C77565;
            }

            .sidebar-storage {
                padding: 16px 22px 20px;
                border-top: 1px solid var(--border);
            }

            .storage-title {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 8px;
                font-size: 12px;
                font-weight: 600;
                color: var(--text-2);
            }

            .storage-bar {
                height: 5px;
                border-radius: 3px;
                background: #DDD7CB;
                overflow: hidden;
            }

                .storage-bar span {
                    display: block;
                    height: 100%;
                    background: var(--sage-strong);
                    border-radius: 3px;
                }

            .storage-text {
                margin-top: 8px;
                font-size: 12px;
                color: var(--text-muted);
            }

            .sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(42, 41, 37, .35);
                z-index: 1035;
            }

            /* =========================================================
                       4. ANA ALAN VE NAVBAR  (_Layout.cshtml / _Navbar.cshtml)
                       ========================================================= */
            .app-main {
                margin-left: var(--sidebar-width);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                transition: margin-left .2s ease;
            }

            body.sidebar-collapsed .app-sidebar {
                transform: translateX(-100%);
            }

            body.sidebar-collapsed .app-main {
                margin-left: 0;
            }

            .app-navbar {
                position: sticky;
                top: 0;
                z-index: 1020;
                display: flex;
                align-items: center;
                gap: 16px;
                height: var(--navbar-height);
                padding: 0 28px 0 20px;
                background: var(--surface);
                border-bottom: 1px solid var(--border);
            }

            .navbar-search {
                position: relative;
                flex: 0 1 420px;
            }

                .navbar-search i {
                    position: absolute;
                    left: 12px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                    font-size: 14px;
                }

                .navbar-search input {
                    width: 100%;
                    height: 38px;
                    padding: 0 12px 0 36px;
                    border: 1px solid var(--border);
                    border-radius: var(--radius);
                    background: var(--surface-soft);
                    font-size: 14px;
                    color: var(--text);
                    transition: border-color .15s, background-color .15s;
                }

                    .navbar-search input::placeholder {
                        color: var(--text-muted);
                    }

                    .navbar-search input:focus {
                        outline: none;
                        border-color: var(--sage);
                        background: var(--surface);
                    }

            .navbar-actions {
                display: flex;
                align-items: center;
                gap: 4px;
                margin-left: auto;
            }

            .notify-dot {
                position: absolute;
                top: 8px;
                right: 9px;
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--peach-strong);
                border: 2px solid var(--surface);
                box-sizing: content-box;
            }

            .navbar-divider {
                width: 1px;
                height: 28px;
                margin: 0 10px;
                background: var(--border);
            }

            .user-toggle {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 4px 8px 4px 4px;
                border: 0;
                border-radius: var(--radius);
                background: transparent;
                text-align: left;
                transition: background-color .15s;
            }

                .user-toggle:hover,
                .user-toggle[aria-expanded="true"] {
                    background: var(--border-soft);
                }

                .user-toggle::after {
                    display: none;
                }

            .user-avatar {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: var(--peach-soft);
                color: var(--peach-strong);
                font-size: 13px;
                font-weight: 600;
                flex-shrink: 0;
            }

            .user-name {
                display: block;
                font-size: 13px;
                font-weight: 600;
                line-height: 1.25;
            }

            .user-email {
                display: block;
                font-size: 12px;
                color: var(--text-muted);
                line-height: 1.25;
            }

            .user-toggle .bi-chevron-down {
                font-size: 11px;
                color: var(--text-muted);
            }

            .dropdown-menu {
                min-width: 220px;
                padding: 6px;
                border: 1px solid var(--border);
                border-radius: var(--radius);
                box-shadow: 0 8px 24px rgba(42, 41, 37, .08);
                font-size: 14px;
            }

            .dropdown-header-user {
                padding: 8px 10px 10px;
                border-bottom: 1px solid var(--border-soft);
                margin-bottom: 6px;
            }

            .dropdown-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                border-radius: var(--radius-sm);
                color: var(--text-2);
            }

                .dropdown-item i {
                    color: var(--text-muted);
                }

                .dropdown-item:hover,
                .dropdown-item:focus {
                    background: var(--sage-tint);
                    color: var(--text);
                }

                .dropdown-item.item-logout,
                .dropdown-item.item-logout i {
                    color: #9E4638;
                }

            .dropdown-divider {
                border-color: var(--border-soft);
                margin: 6px 0;
            }

            /* =========================================================
                       5. GELEN KUTUSU  (Inbox.cshtml)
                       ========================================================= */
            .inbox-container {
                flex: 1;
                width: 100%;
                padding: 28px 32px 40px;
            }

            .inbox-header {
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 20px;
            }

            .inbox-title {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 10px;
                margin: 0;
                font-size: 22px;
                font-weight: 700;
                letter-spacing: -0.02em;
            }

            .inbox-stat {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 3px 9px;
                border: 1px solid var(--border);
                border-radius: var(--radius-sm);
                background: var(--surface);
                font-size: 12px;
                font-weight: 500;
                color: var(--text-2);
                letter-spacing: 0;
            }

                .inbox-stat.is-unread {
                    border-color: transparent;
                    background: var(--sage-soft);
                    color: var(--sage-strong);
                }

                    .inbox-stat.is-unread::before {
                        content: "";
                        width: 6px;
                        height: 6px;
                        border-radius: 50%;
                        background: var(--sage-strong);
                    }

            .inbox-subtitle {
                margin: 4px 0 0;
                color: var(--text-muted);
            }

            .inbox-updated {
                font-size: 12px;
                color: var(--text-muted);
                white-space: nowrap;
            }

            /* Filtre ve arama satırı */
            .inbox-filter-bar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                margin-bottom: 16px;
                border-bottom: 1px solid var(--border);
            }

            .inbox-filters {
                display: flex;
                gap: 4px;
                overflow-x: auto;
                scrollbar-width: none;
            }

                .inbox-filters::-webkit-scrollbar {
                    display: none;
                }

            .inbox-filter {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 10px 12px 11px;
                margin-bottom: -1px;
                border: 0;
                border-bottom: 2px solid transparent;
                background: transparent;
                color: var(--text-muted);
                font-size: 14px;
                font-weight: 500;
                white-space: nowrap;
                transition: color .15s, border-color .15s;
            }

                .inbox-filter:hover {
                    color: var(--text);
                }

                .inbox-filter.active {
                    color: var(--sage-strong);
                    border-bottom-color: var(--sage-strong);
                    font-weight: 600;
                }

            .filter-count {
                padding: 0 6px;
                border-radius: 4px;
                background: var(--border-soft);
                color: var(--text-muted);
                font-size: 11px;
                font-weight: 600;
                line-height: 18px;
            }

            .inbox-filter.active .filter-count {
                background: var(--sage-soft);
                color: var(--sage-strong);
            }

            .inbox-search {
                position: relative;
                flex: 0 0 280px;
                margin-bottom: 8px;
            }

                .inbox-search i {
                    position: absolute;
                    left: 11px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                    font-size: 13px;
                }

                .inbox-search input {
                    width: 100%;
                    height: 34px;
                    padding: 0 12px 0 32px;
                    border: 1px solid var(--border);
                    border-radius: var(--radius-sm);
                    background: var(--surface);
                    font-size: 13px;
                    color: var(--text);
                }

                    .inbox-search input::placeholder {
                        color: var(--text-muted);
                    }

                    .inbox-search input:focus {
                        outline: none;
                        border-color: var(--sage);
                    }

            /* Mesaj listesi yüzeyi: araç çubuğu + satırlar + alt bilgi */
            .inbox-panel {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                overflow: hidden;
            }

            /* Toplu işlem araç çubuğu */
            .inbox-toolbar {
                display: flex;
                align-items: center;
                gap: 4px;
                height: 48px;
                padding: 0 12px 0 20px;
                border-bottom: 1px solid var(--border);
                background: var(--surface-soft);
            }

                .inbox-toolbar .form-check-input {
                    margin: 0 10px 0 0;
                }

            .toolbar-divider {
                width: 1px;
                height: 20px;
                margin: 0 6px;
                background: var(--border);
            }

            .inbox-toolbar .icon-btn {
                width: 32px;
                height: 32px;
                font-size: 15px;
            }

            .bulk-action {
                opacity: .45;
            }

            .inbox-toolbar.has-selection .bulk-action {
                opacity: 1;
            }

            .selection-info {
                margin-left: 8px;
                font-size: 13px;
                font-weight: 500;
                color: var(--sage-strong);
            }

            .toolbar-pagination {
                display: flex;
                align-items: center;
                gap: 2px;
                margin-left: auto;
                font-size: 12px;
                color: var(--text-muted);
            }

                .toolbar-pagination span {
                    margin-right: 6px;
                    white-space: nowrap;
                }

                .toolbar-pagination .icon-btn:disabled {
                    opacity: .35;
                    pointer-events: none;
                }

            .is-spinning i {
                animation: spin .6s linear;
            }

            @@keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }

            /* =========================================================
                       6. E-POSTA SATIRI
                       ========================================================= */
            .mail-list {
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .mail-item {
                position: relative;
                display: grid;
                grid-template-columns: 18px 20px 34px minmax(120px, 190px) minmax(0, 1fr) auto;
                grid-template-areas: "check star avatar sender body meta";
                align-items: center;
                column-gap: 14px;
                padding: 13px 20px;
                border-bottom: 1px solid var(--border-soft);
                background: var(--surface);
                transition: background-color .12s;
            }

                .mail-item:last-child {
                    border-bottom: 0;
                }

                .mail-item[hidden] {
                    display: none;
                }

                .mail-item:hover {
                    background: #FAF8F4;
                }

                .mail-item.is-selected {
                    background: var(--sage-tint);
                }

                /* Okunmamış mesaj: sol kenarda ince gösterge */
                .mail-item[data-read="false"]::before {
                    content: "";
                    position: absolute;
                    left: 0;
                    top: 10px;
                    bottom: 10px;
                    width: 3px;
                    border-radius: 0 2px 2px 0;
                    background: var(--sage-strong);
                }

            .mail-select {
                grid-area: check;
                display: flex;
            }

                .mail-select .form-check-input {
                    margin: 0;
                }

            .mail-star {
                grid-area: star;
                padding: 0;
                border: 0;
                background: none;
                color: #C9C3B7;
                font-size: 15px;
                line-height: 1;
                transition: color .15s;
            }

                .mail-star:hover {
                    color: #D4A24C;
                }

            .mail-item[data-starred="true"] .mail-star {
                color: #D4A24C;
            }

            .mail-avatar {
                grid-area: avatar;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 34px;
                height: 34px;
                border-radius: 50%;
                font-size: 12px;
                font-weight: 600;
            }

            .avatar-sage {
                background: #E1ECE3;
                color: #44704F;
            }

            .avatar-peach {
                background: #FBE6D8;
                color: #A65A32;
            }

            .avatar-sand {
                background: #F3E8C9;
                color: #866A22;
            }

            .avatar-mist {
                background: #DFE7EA;
                color: #4B6672;
            }

            .avatar-stone {
                background: #E9E5DD;
                color: #625D53;
            }

            .avatar-rose {
                background: #F5DCD6;
                color: #9E4638;
            }

            .mail-sender {
                grid-area: sender;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
                font-weight: 500;
                color: var(--text-2);
            }

            .mail-body {
                grid-area: body;
                display: flex;
                align-items: baseline;
                gap: 8px;
                min-width: 0;
                color: var(--text-2);
            }

            .mail-subject {
                flex-shrink: 0;
                max-width: 55%;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .mail-preview {
                flex: 1;
                min-width: 0;
                overflow: hidden;
                white-space: nowrap;
                text-overflow: ellipsis;
                color: var(--text-muted);
            }

                .mail-preview::before {
                    content: "—";
                    margin-right: 8px;
                    color: #CFC9BD;
                }

            /* Okunmamış mesajlarda daha belirgin metin */
            .mail-item[data-read="false"] .mail-sender,
            .mail-item[data-read="false"] .mail-subject {
                font-weight: 600;
                color: var(--text);
            }

            .mail-meta {
                grid-area: meta;
                display: grid;
                grid-template-columns: 76px 16px 54px;
                align-items: center;
                column-gap: 12px;
            }

            .mail-label {
                grid-column: 1;
                justify-self: end;
                padding: 2px 8px;
                border-radius: 4px;
                font-size: 11px;
                font-weight: 600;
                line-height: 16px;
                white-space: nowrap;
            }

            .label-work {
                background: var(--label-work-bg);
                color: var(--label-work-text);
            }

            .label-personal {
                background: var(--label-personal-bg);
                color: var(--label-personal-text);
            }

            .label-important {
                background: var(--label-important-bg);
                color: var(--label-important-text);
            }

            .label-invoice {
                background: var(--label-invoice-bg);
                color: var(--label-invoice-text);
            }

            .label-support {
                background: var(--label-support-bg);
                color: var(--label-support-text);
            }

            .mail-attachment {
                grid-column: 2;
                color: var(--text-muted);
                font-size: 15px;
            }

            .mail-date {
